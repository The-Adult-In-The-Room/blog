{
	"ci": {
		"collect": {
			"numberOfRuns": 3,
			"startServerCommand": "node .output/server/index.mjs",
			"startServerReadyPattern": "Listening on:",
			"url": [
				"http://localhost:3000/",
				"http://localhost:3000/posts/rules-of-engagement"
			],
			"settings": {
				"preset": "desktop",
				"chromeFlags": "--no-sandbox --headless"
			}
		},
		"assert": {
			"assertions": {
				"categories:performance": ["warn", { "minScore": 0.75 }],
				"categories:accessibility": ["warn", { "minScore": 0.7 }],
				"categories:best-practices": ["warn", { "minScore": 0.5 }],
				"categories:seo": ["warn", { "minScore": 0.8 }],

			"color-contrast": ["error", { "minScore": 1 }],
			"errors-in-console": ["error", { "minScore": 1 }],
			"document-latency-insight": ["error", { "minScore": 1 }],
				"critical-request-chains": ["error", { "minScore": 1 }],
				"render-blocking-resources": "error"
			}
		}
	}
}
