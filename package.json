{
  "name": "blog",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "generate-routes": "tsr generate",
    "build": "vite build && node scripts/compress-html.mjs",
    "preview": "vite preview --port 3000",
    "test:e2e:acceptance": "playwright test e2e/acceptance",
    "test:e2e:smoke": "playwright test --config=e2e/playwright.smoke.config.ts",
    "test:e2e:regression": "playwright test e2e/regression",
    "format": "biome format",
    "lint": "biome lint",
    "check": "biome check",
    "fix": "biome check --write",
    "ts:check": "tsc",
    "test": "vitest --coverage",
    "test:ci": "vitest run --coverage",
    "test:watch": "vitest",
    "verify": "tsc && biome ci && npm run test:ci",
    "start": "node .output/server/index.mjs"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/markdown": "^1.0.0",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-start": "1.169.4",
    "@tanstack/redact": "^0.2.0",
    "gray-matter": "^4.0.3",
    "nitro": "3.0.260903-beta",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@lhci/cli": "^0.15.1",
    "@lightpanda/browser": "^1.6.0",
    "@playwright/test": "^1.64.1",
    "@rolldown/plugin-babel": "^0.2.4",
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/devtools-vite": "^0.8.5",
    "@tanstack/react-devtools": "^0.10.13",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@tanstack/router-cli": "^1.167.46",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "babel-plugin-react-compiler": "^1.0.0",
    "happy-dom": "^21.0.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "@lightpanda/browser@1.6.0": true
  }
}
